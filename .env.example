# Supabase Public & Anon Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cashfree Payment Gateway Configuration
CASHFREE_APP_ID=cf_test_your_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2023-08-01
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# App URL
NEXT_PUBLIC_APP_URL=https://localloop.vercel.app

# AI Provider Configuration (Server-Side Only - Checkpoint CP-AI01)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-1.5-flash

# Firebase Phone OTP & Authentication Configuration
FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy_your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Carrier SMS Gateway (Production Live SMS Delivery)
# Fast2SMS (India Priority Gateway): https://www.fast2sms.com
FAST2SMS_API_KEY=your_fast2sms_api_key
# Twilio SMS (Global Gateway): https://www.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
# 2Factor.in (India OTP Gateway): https://2factor.in
TWO_FACTOR_API_KEY=your_2factor_api_key
