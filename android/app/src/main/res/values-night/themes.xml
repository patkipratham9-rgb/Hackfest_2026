<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Night Mode. -->
    <style name="Theme.LocalLoop" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/localloop_terracotta</item>
        <item name="colorPrimaryDark">@color/localloop_terracotta_dark</item>
        <item name="colorSecondary">@color/localloop_terracotta</item>
        <item name="android:windowBackground">@color/localloop_charcoal</item>

        <!-- Status Bar & Navigation Bar Colors in Night Mode -->
        <item name="android:statusBarColor">@color/localloop_charcoal</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/localloop_charcoal</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
